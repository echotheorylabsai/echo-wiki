    {"type": "text", "id": "t_invariant", "x": 60, "y": 1408, "width": 1100, "height": 20, "text": "The guarantee: everything in the KB can be regenerated from raw/ at any time — receipts in, knowledge out.", "originalText": "The guarantee: everything in the KB can be regenerated from raw/ at any time — receipts in, knowledge out.", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 600037, "version": 1, "versionNonce": 600038, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}
